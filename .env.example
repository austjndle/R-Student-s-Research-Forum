# Gemini API key for server-side AI Assistant
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Secret for signing / integrity-protecting anonymous visitor cookie session.
# Required in every environment; do not use a committed fallback.
ANONYMOUS_SESSION_SECRET=

# Shared secret for an approved Outlook/forwarding relay to queue Campus Buzz messages.
CAMPUS_BUZZ_INGEST_TOKEN=

# AI Limit Configurations
AI_DAILY_LIMIT=10
AI_GLOBAL_DAILY_LIMIT=1000
APP_TIMEZONE=Asia/Ho_Chi_Minh
